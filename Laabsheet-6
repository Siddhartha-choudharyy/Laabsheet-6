13. Sort Names of Students Using Bubble Sort

c
#include <stdio.h>
#include <string.h>

int main() {
    int n;
    printf("Enter the number of students: ");
    scanf("%d", &n);
    getchar(); // Clear trailing newline from buffer

    char names[n][50]; // 2D array to hold string elements
    char temp[50];

    printf("Enter names of %d students:\n", n);
    for(int i = 0; i < n; i++) {
        fgets(names[i], sizeof(names[i]), stdin);
        names[i][strcspn(names[i], "\n")] = 0; // Strip newline char
    }

    // Bubble sort to organize strings alphabetically
    for(int i = 0; i < n - 1; i++) {
        for(int j = 0; j < n - i - 1; j++) {
            if(strcmp(names[j], names[j+1]) > 0) {
                strcpy(temp, names[j]);
                strcpy(names[j], names[j+1]);
                strcpy(names[j+1], temp);
            }
        }
    }

    printf("\nAlphabetically Sorted Student Names:\n");
    for(int i = 0; i < n; i++) {
        printf("%s\n", names[i]);
    }
    return 0;
}
